# Copy this file to `.env` to change local settings (`.env` is not committed).
# Everything is optional; the defaults below are used when a line is commented out.
# Real environment variables (Docker, Azure Container Apps, your shell) win over this file.

# Folder where the JSON data files are saved. Relative paths are resolved from
# the folder you run npm from (the project folder). Default: ./data
# DATA_DIR=./data
# DATA_DIR=/mnt/share/sb-group-attendance

# Port for the API server (and the built site with `npm start`). Default: 3001
# PORT=3001

# Address the server listens on. Default: 0.0.0.0 (all network interfaces).
# Use 127.0.0.1 to allow connections from this computer only.
# HOST=0.0.0.0

# Shared site password. Everyone uses this one password to open the site.
# REQUIRED when NODE_ENV=production (the server refuses to start without it).
# In local development it's optional: without it the site is open, with a warning.
# Use a placeholder like this for local testing only. Never commit a real password.
# SITE_PASSWORD=change-me-local-dev

# Optional key for signing sign-in cookies (any long random string, e.g. from
# `openssl rand -hex 32`). If not set, a random key is chosen at startup, so a
# restart signs everyone out. Changing SITE_PASSWORD always signs everyone out.
# SESSION_SECRET=

# How long a sign-in lasts, in minutes (1-60, default 60). Never longer than an hour.
# SESSION_TTL_MINUTES=60

# Mark the sign-in cookie Secure: auto (default: when the request came over
# HTTPS, including behind Azure's HTTPS proxy), true, or false.
# COOKIE_SECURE=auto
